# open-webui 本地配置示例：复制成 .env 后按需修改（docker compose 会自动读取同目录 .env）
# 复制命令：copy .env.example .env

# 监听地址：默认只绑本机。要让局域网其他机器访问再改成 0.0.0.0
OPEN_WEBUI_HOST=127.0.0.1
OPEN_WEBUI_PORT=3000

# 镜像标签
WEBUI_DOCKER_TAG=main

# 向量模型：默认句子向量模型；首次启动会从 HuggingFace 下载约 930MB
# 内网/离线环境建议提前把模型放到数据卷里，再把这里指向容器内绝对路径
# （retrieval/utils.py:1685 get_model_path 发现路径存在会直接返回，不再联网）
# RAG_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# HuggingFace 下载相关：代理链路不稳时保持这几个值
HF_HUB_DISABLE_XET=1
HF_HUB_DOWNLOAD_TIMEOUT=60
HF_HUB_ETAG_TIMEOUT=30

# 如果本机代理只监听 127.0.0.1、而 Docker 引擎跑在 WSL 里，
# 容器/引擎都够不到它，需要先把代理暴露到 WSL 网关可达的地址
# （本项目用 relay_7897.py + Docker Desktop 手动代理，见 ARCHITECTURE.md §8.2/§8.3）